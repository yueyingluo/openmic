{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenMic pairwise judge response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "winner",
    "evidence_a",
    "evidence_b",
    "reason"
  ],
  "properties": {
    "status": {
      "enum": [
        "judged",
        "abstain"
      ]
    },
    "winner": {
      "enum": [
        "A",
        "B",
        "tie",
        null
      ]
    },
    "evidence_a": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "evidence_b": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "judged"
          }
        }
      },
      "then": {
        "properties": {
          "winner": {
            "enum": [
              "A",
              "B",
              "tie"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "winner": {
            "type": "null"
          }
        }
      }
    }
  ]
}
