.env
.venv
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store
artifacts/

# Local JYB environments, credentials and generated media.
.venv*/
.env.*
!.env.example
outputs/
*.wav
*.mp3
*.flac
*.ogg
*.pcm
*.pt
*.pth
*.onnx

# Evaluation runtime data and machine-specific configuration stay local.
evaluation/runtime/data/
evaluation/runtime/models/
evaluation/runtime/downloaded_models/
evaluation/runtime/gpu_results/
evaluation/runtime/reports/
evaluation/*.local.yaml
evaluation/runtime/*.local.yaml

# Publish only the shared deck and its README; keep personal drafts local.
/presentation/*
!/presentation/README.md
!/presentation/midterm.html

# Local audio for the JYB comparison page stays out of Git.
/docs/media/

# Three reviewed classroom excerpts travel with the JYB slides.
!/assets/jyb_midterm_audio/deadline_01_baseline.wav
!/assets/jyb_midterm_audio/deadline_02_first_performance.wav
!/assets/jyb_midterm_audio/deadline_03_integrity_repair.wav
