# Copy to .env locally. Never commit real keys.
# OpenAI-compatible endpoint. DeepSeek is a recommended baseline.
OPENMIC_API_KEY=
OPENMIC_BASE_URL=https://api.deepseek.com
OPENMIC_MODEL=deepseek-chat

# 也兼容已有项目常用命名：LLM_API_KEY / LLM_BASE_URL / LLM_MODEL。

# SiliconFlow TTS（省略时使用以下默认值）
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
TTS_FORMAT=wav
TTS_SAMPLE_RATE=16000
